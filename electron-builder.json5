// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.lesedikekana.diff",
  "asar": true,
  "productName": "diff",
  "directories": {
    "output": "release/${version}",
    "buildResources": "public"
  },
  "files": [
    "dist",
    "dist-electron",
    "rust/language-detection/index.js",
    "rust/language-detection/index.d.ts",
    // "rust/language-detection/npm/**/*"
    "rust/language-detection/language-detection.*.node"
  ],
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["x64", "arm64"] },
      { "target": "zip", "arch": ["x64", "arm64"] }
    ],
    "artifactName": "${productName}-Mac-${version}-Installer-${arch}.${ext}"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-${arch}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": true
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "artifactName": "${productName}-Linux-${version}.${ext}"
  }
}
